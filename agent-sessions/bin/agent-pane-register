#!/usr/bin/env python3

# __author__ == Junfeng Lei

"""Hook target: record or erase the tmux-pane -> agent-session binding.

Invoked from a Claude Code or Codex SessionStart/SessionEnd hook, with the hook
JSON payload on stdin:

    agent-pane-register <claude|codex> <start|end>

Writes ~/.cache/agent-panes/<pane>.json, keyed by tmux's stable %N pane id, which
is what agent-panes reads back. Alongside the session id the record carries the
agent pid and its kernel start time, so a record left behind by a session that
died without firing its end hook can be recognised as stale rather than
misattributed to whatever agent occupies that pane next -- and the id of the
tmux server that issued the pane id, because that record is not thrown away.
A killed agent's record is the only place its session id exists until a save
has seen it, so it is kept for as long as that server runs: agent-resume
offers it, and the resurrect save hook folds it into its sidecar.

Exits quietly when TMUX_PANE is unset: the session is not running under tmux and
there is no pane to bind it to. It exits 0 on every other failure too -- this is
best-effort bookkeeping running on every session start and end, and it should
never be the reason a session start reports an error.
"""

import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "lib"))
import procinfo  # noqa: E402
from agents import agent_kind  # noqa: E402

REG = os.path.expanduser("~/.cache/agent-panes")
TMUX_TIMEOUT_S = 2


def agent_process():
    """Nearest ancestor that is the agent itself, with its start time.

    Hooks are spawned below the agent, but not always as its direct child, so
    getppid() alone is not enough.
    """
    pid = os.getppid()
    for _ in range(12):
        if pid <= 1:
            break
        parent, comm = procinfo.ppid(pid), procinfo.comm(pid)
        if parent is None:
            break
        if agent_kind(pid, comm):
            return pid, procinfo.start_token(pid)
        pid = parent
    return None, None


def pane_root(pane):
    """The pid tmux started that pane with (`#{pane_pid}`), or None.

    Asked of tmux rather than read off the processes: the pane's own process is
    the one carrying TMUX_PANE as tmux set it, but on macOS it is usually
    /bin/zsh, a platform binary whose environment no other process may read.
    """
    try:
        out = subprocess.run(
            ["tmux", "display-message", "-p", "-t", pane, "#{pane_pid}"],
            capture_output=True,
            text=True,
            timeout=TMUX_TIMEOUT_S,
        ).stdout.strip()
        return int(out)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def in_pane(pid, pane):
    """Whether pid runs inside that pane: at or below the pane's own process.

    The live scan's rule too. TMUX_PANE is inherited, not assigned: an editor
    window opened by `code .` from a pane hands it to every terminal it opens,
    and an agent started there would otherwise be filed under this pane -- and,
    once killed, kept and folded into its history as a session that ran here.
    One tmux call, on session start only, and never in the save hook.
    """
    root = pane_root(pane)
    if root is None:
        return False
    for _ in range(64):
        if pid == root:
            return True
        pid = procinfo.ppid(pid)
        if not pid or pid <= 1:
            return False
    return False


def prune(reg):
    """Drop the records nothing can use any more.

    One whose agent is still running stays, and so does one whose agent is gone
    while the server that issued its pane id still runs: that is a killed agent,
    and until a save folds it into the sidecar this file is the only place its
    session id exists. The pane number pins it only within that server, so once
    the server has exited the record goes. So does one missing either identity
    pair, which nothing could ever check: agent-panes would have to trust it
    forever.
    """
    for name in os.listdir(reg):
        if not name.endswith(".json"):
            continue
        path = os.path.join(reg, name)
        try:
            stamp = os.stat(path).st_mtime_ns
            with open(path) as fh:
                rec = json.load(fh)
        except (OSError, ValueError):
            continue
        if not isinstance(rec, dict):
            rec = {}
        pid, start, updated = rec.get("pid"), rec.get("proc_start"), rec.get("updated")
        # Only what run() writes counts as an identity pair. A hand-edited pid
        # of another type raises out of the macOS backend, which would stop the
        # prune on every hook run with this file still in place.
        if isinstance(pid, int) and not isinstance(pid, bool) and pid > 0 and start:
            if str(procinfo.start_token(pid)) == str(start):
                continue
            if (
                rec.get("session_id")
                and isinstance(updated, (int, float))
                and procinfo.tmux_server_running(rec.get("server"), updated)
            ):
                continue
        try:
            # Re-check mtime: a session that claimed this pane after the read
            # above must not have its fresh record deleted.
            if os.stat(path).st_mtime_ns == stamp:
                os.remove(path)
        except OSError:
            pass


def run():
    agent = sys.argv[1] if len(sys.argv) > 1 else "unknown"
    action = sys.argv[2] if len(sys.argv) > 2 else "start"

    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return 0

    os.makedirs(REG, exist_ok=True)
    path = os.path.join(REG, f'{pane.lstrip("%")}.json')

    if action == "end":
        # Only this agent's own record. Another agent can end with the same
        # pane id -- a parallel `claude -p`, or one in a window opened from this
        # pane -- and the record may be a killed agent's, the only copy of its id.
        pid, _ = agent_process()
        try:
            with open(path) as fh:
                rec = json.load(fh)
            if pid and isinstance(rec, dict) and rec.get("pid") == pid:
                os.remove(path)
        except (OSError, ValueError):
            pass
        prune(REG)
        return 0

    # Hooks are handed their payload on a pipe that is closed for us. A tty means
    # nobody is going to send one, and reading would block until the hook timeout.
    payload = {}
    if not sys.stdin.isatty():
        try:
            payload = json.load(sys.stdin)
        except (ValueError, OSError):
            payload = {}
    if not isinstance(payload, dict):
        payload = {}

    session_id = ""
    for key in ("session_id", "sessionId", "thread_id", "threadId", "conversation_id"):
        if payload.get(key):
            session_id = payload[key]
            break

    pid, proc_start = agent_process()
    if not pid or not proc_start or not in_pane(pid, pane):
        # Without the identity pair the record could never be checked against a
        # live process, so agent-panes would serve it to whatever agent occupies
        # this pane next. No record is better than an unguardable one -- or than
        # one for an agent that only inherited this pane's id, which would also
        # overwrite the record of the agent that really ran here.
        prune(REG)
        return 0

    record = dict(
        agent=agent,
        pane_id=pane,
        session_id=session_id,
        # Claude's SessionStart payload spells the title `session_title`; it is
        # present only once the session has been named.
        name=payload.get("session_title") or payload.get("thread_name") or "",
        cwd=payload.get("cwd") or os.getcwd(),
        transcript=payload.get("transcript_path") or payload.get("rollout_path") or "",
        pid=pid,
        proc_start=proc_start,
        # Which server issued TMUX_PANE. The record outlives a killed agent, and
        # its pane number names this pane only while this server runs.
        server=procinfo.tmux_server_id(),
        updated=time.time(),
    )

    # The tmp name carries our pid: two hooks firing for the same pane (parallel
    # `claude -p` from one pane, say) must not share a scratch file, or the loser
    # replaces a path its own writer already moved away.
    tmp = f"{path}.{os.getpid()}.tmp"
    try:
        with open(tmp, "w") as fh:
            json.dump(record, fh)
        os.replace(tmp, path)  # atomic; a concurrent reader never sees a partial file
    except OSError:
        try:
            os.remove(tmp)
        except OSError:
            pass
    prune(REG)
    return 0


def main():
    """Bookkeeping only: never fail a session start or end that would otherwise work."""
    try:
        return run()
    except Exception:
        return 0


if __name__ == "__main__":
    sys.exit(main())
