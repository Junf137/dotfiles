#!/bin/bash

# __author__ == Junfeng Lei

# List the running Claude Code sessions: each one's tmux pane, directory, git
# branch, uptime, CPU and memory. agent-panes is the one that maps panes to
# session ids; this one also shows sessions outside tmux, and what each costs.
#
# Usage: claude-sessions [-n|--no-color]

BOLD='\033[1m'
DIM='\033[2m'
GREEN='\033[32m'
RESET='\033[0m'

for arg in "$@"; do
    case "$arg" in
        -h | --help)
            echo "Usage: claude-sessions [-n|--no-color]"
            exit 0
            ;;
        -n | --no-color) BOLD='' DIM='' GREEN='' RESET='' ;;
    esac
done

# Controlling terminal of a pid, as a /dev path. `ps -o tty=` prints it without
# the /dev prefix and spells it differently per kernel -- `pts/3` on Linux,
# `ttys003` on macOS -- but both agree with what `tty` reports once prefixed,
# which is what the current-session marker compares against.
proc_tty() {
    local t
    t=$(ps -o tty= -p "$1" 2>/dev/null | tr -d '[:space:]')
    case "$t" in
        '' | '?' | '??' | '-') echo "" ;;
        /dev/*) echo "$t" ;;
        *) echo "/dev/$t" ;;
    esac
}

# Working directory of a pid. Linux keeps it a readlink away; macOS has no
# /proc, and lsof is the only reader of it that ships with the system.
proc_cwd() {
    if [ -e "/proc/$1/cwd" ]; then
        readlink "/proc/$1/cwd" 2>/dev/null
    else
        lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1
    fi
}

# RSS in KiB, as ps reports it, to M or G with one decimal.
human_kb() {
    local mb=$(($1 / 1024))
    if [ "$mb" -gt 1024 ]; then
        echo "$((mb / 1024)).$(((mb % 1024) * 10 / 1024))G"
    else
        echo "${mb}M"
    fi
}

# The first argument is the row's colour; the reset goes before the newline, so
# piped output never starts a line with an escape.
row() {
    local color=$1
    shift
    printf '%b%-2s%-8s%-22s%-18s%11s %6s %7s  %s%b\n' "$color" "$@" "${color:+$RESET}"
}

# Not `pgrep -x claude`: BSD pgrep omits its own ancestors, so on macOS that
# silently skips the one session you are sitting in -- the very session this
# marks as current. ps sees all of them on both kernels; the basename strip is
# for macOS, which prints argv[0] here rather than the kernel's comm.
CLAUDE_PIDS=$(ps -axo pid=,comm= 2>/dev/null |
    awk '{ name = $NF; sub(/.*\//, "", name); if (name == "claude") print $1 }')

if [ -z "$CLAUDE_PIDS" ]; then
    echo "No Claude Code sessions found."
    exit 0
fi

CURRENT_TTY=$(tty 2>/dev/null)
PANES=$(tmux list-panes -a -F '#{pane_tty}|#{session_name}:#{window_index}.#{pane_index}' 2>/dev/null)

row "$BOLD" "" PID PANE BRANCH UPTIME CPU MEM DIRECTORY

count=0
total_kb=0
for pid in $CLAUDE_PIDS; do
    # Only this user's: kill -0 is refused for another user's process, whose cwd
    # is unreadable anyway, and ps -ax lists those too.
    kill -0 "$pid" 2>/dev/null || continue
    # Also the liveness check: a process that exited since the scan prints nothing.
    read -r elapsed cpu rss_kb < <(ps -p "$pid" -o etime=,%cpu=,rss= 2>/dev/null) || continue
    [[ "$rss_kb" =~ ^[0-9]+$ ]] || rss_kb=0

    tty_path=$(proc_tty "$pid")
    cwd=$(proc_cwd "$pid")

    pane=""
    [ -n "$tty_path" ] && pane=$(awk -F'|' -v t="$tty_path" '$1 == t { print $2; exit }' <<<"$PANES")

    # `git -C ""` would answer for this shell's own directory, not the session's.
    branch=""
    [ -n "$cwd" ] && branch=$(git -C "$cwd" branch --show-current 2>/dev/null)

    mark=""
    [ -n "$tty_path" ] && [ "$tty_path" = "$CURRENT_TTY" ] && mark="*"

    count=$((count + 1))
    total_kb=$((total_kb + rss_kb))

    # Cut to the column with a marker, so a cut name never reads as a real one.
    [ ${#pane} -gt 21 ] && pane=${pane:0:19}..
    [ ${#branch} -gt 17 ] && branch=${branch:0:15}..
    cwd=${cwd/#"$HOME"/\~}
    row "${mark:+$GREEN}" "$mark" "$pid" "${pane:--}" "${branch:--}" "$elapsed" "$cpu%" "$(human_kb "$rss_kb")" "${cwd:--}"
done

printf '\n%b%d session(s), %s resident; * marks this one%b\n' "$DIM" "$count" "$(human_kb "$total_kb")" "$RESET"
