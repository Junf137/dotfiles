#!/usr/bin/env python3

# __author__ == Junfeng Lei

"""Resume the Claude Code / Codex session that belongs to this tmux pane.

Run it in any pane. If exactly one agent session maps to that pane -- and only
then -- that session is resumed in a new pane split off to its right, in the
directory it was opened in:

    claude --dangerously-skip-permissions --resume <uuid>
    codex resume <uuid> --yolo

Once the agent is up, the old pane's history is compared with the session's
transcript. If they match, the old pane is closed -- only ever the pane this
runs in, and never one with an agent in it; if not, both panes stay and the old
one says why, so a wrong mapping costs a pane to close rather than the history
it was read from. `--here` resumes in place instead: the old pane is
cleared (its scrollback kept) and becomes the session's pane.

There is deliberately no way to start a session this could not map on its own.
If the pane maps to none, or to more than one, nothing is run: `--list` prints
the candidates with the command each would need, and pasting one is a decision a
person made rather than a guess this tool got away with. A wrong id resumes
somebody else's conversation and reads exactly like a right one until it is too
late, so every doubt is spent on refusing:

  * an id that is not a well-formed uuid is not a candidate;
  * a session whose transcript is no longer on disk cannot be resumed, so it is
    listed but never chosen, and never makes a pane ambiguous;
  * a stanza in this pane's scrollback that claims this server but a different
    pane is text that arrived here, not history that happened here, and is
    dropped whole;
  * two candidates are two candidates, however much better one of them looks.

Three sources answer "which sessions has this pane held", each covering what the
others cannot:

  * the resurrect sidecar, `agent_sessions.json` -- every session a save ever saw
    running here, filtered to records this tmux server issued the `%N` for. A
    record stamped with an older generation names whatever pane held that number
    then, not this one;
  * this pane's own scrollback -- the block agent-panes-resurrect injected (which
    is what carries ids across a reboot, since the restored pane replays it) plus
    whatever exit banner the agent itself printed. This is the only source in the
    window between a restore and the first save after it, and the only one for a
    session that started and exited between two saves;
  * the hook cache, `~/.cache/agent-panes/<pane>.json` -- for an agent *killed*
    before any save saw it, the only place that session's id exists until the
    next save folds it into the sidecar. The session hook keeps such a record
    for as long as the tmux server that issued its pane id runs, because
    killing an agent while keeping its pane is the case this whole family of
    tools is built around.

Usage: agent-resume [-n|--dry-run] [-l|--list] [--here] [--pane %N] [--force]
Exit:  0 resumed (and the old pane closed), 1 nothing resumable here, 2 more
       than one session maps here, 3 refused, 4 resumed beside the old pane,
       which was kept.
Env:   SCROLLBACK_DEPTH  value passed to `tmux capture-pane -S` (default '-',
                         the pane's whole history; one pane, so it is cheap).
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))

# Imported directly rather than reached through the lender below. What is
# borrowed from those two is their *parsing rules*, which must not drift; the
# platform layer is not theirs to re-export, and going through them would hide
# these calls from check.sh's borrowed-name pass.
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "lib"))
import agents  # noqa: E402
import procinfo  # noqa: E402

# What resuming actually runs. Spelled out as literal argv rather than composed,
# because these are dangerous flags and the reader should be able to see exactly
# what they are without following a builder. Passed to execvp as a list, so no
# field is ever handed to a shell.
RESUME_ARGV = {
    "claude": ("claude", "--dangerously-skip-permissions", "--resume", "{sid}"),
    "codex": ("codex", "resume", "{sid}", "--yolo"),
}

# One pane, one capture, so the default is the whole history rather than
# agent-scrollback-ids' 20k -- that tool pays the cost once per pane on a server
# with dozens of them. The env var is shared so setting it once means the same
# thing to both.
DEPTH = os.environ.get("SCROLLBACK_DEPTH") or "-"

TMUX_TIMEOUT_S = 5


def load(name):
    """Import a sibling tool as a module.

    Deliberately *not* guarded, unlike the same import inside the save hook. The
    hook must survive a broken import because tmux-resurrect discards its exit
    status and a dead hook would be completely silent; this is an interactive
    command whose entire job is the imported parsing, so a failure here has to be
    said out loud.
    """
    path = os.path.join(HERE, name)
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), path)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


RESURRECT = load("agent-panes-resurrect")
REGISTER = load("agent-pane-register")

UUID_RE = re.compile(RESURRECT.UUID)


# ---* Where a pane's sessions come from *---


def sidecar_path():
    """The save hook's sidecar: its records, and the titles it refused."""
    return os.path.join(RESURRECT.resurrect_dir(), RESURRECT.SIDECAR_NAME)


def sidecar_rows(pane, server):
    """Sidecar records for this pane, from this server generation only.

    `%N` is a per-server counter that restarts at 0 while the sidecar
    deliberately outlives the server by KEEP_DAYS, so a record carrying an older
    server id names whichever pane inherited that number, not this one. Nothing
    is lost by dropping them: a restored pane replays its own block, and
    capture_rows() reads that back.
    """
    rows = []
    for records in RESURRECT.read_sidecar(sidecar_path()).values():
        if not isinstance(records, list):
            continue
        for record in records:
            if not isinstance(record, dict):
                continue
            if record.get("pane_id") == pane and record.get("server") == server:
                rows.append(dict(record, origin="sidecar"))
    return rows


def capture(pane):
    """This pane's scrollback, as bytes.

    `-epJ` matches what tmux-resurrect archives, and each flag is load-bearing:
    `-J` rejoins wrapped lines, without which a resume line wider than the pane
    splits its uuid across two rows and matches nothing, and `-e` keeps the
    escapes so the marker predicate sees the same shape it was written to match.
    """
    try:
        out = subprocess.run(
            ["tmux", "capture-pane", "-epJ", "-S", DEPTH, "-t", pane],
            capture_output=True,
            timeout=TMUX_TIMEOUT_S,
        )
    except (OSError, subprocess.SubprocessError):
        return b""
    return out.stdout if out.returncode == 0 else b""


def capture_rows(pane, server):
    """Sessions this pane's own scrollback still remembers.

    Two passes over one capture, exactly as the save hook's harvest does it: our
    injected block through parse_stanzas(), which refuses a stanza claiming this
    server but another pane, and the remaining text through the shared
    resume-marker patterns, which is where an agent's own exit banner is found.

    Both passes are capped by the harvest's own cap_stanzas() and
    cap_recovered(). A `cat` of a session dump, a ripgrep over a directory of
    handoff notes, or a restored pane displaying the archive itself puts
    hundreds of resume commands into one pane's history, every one of them
    indistinguishable from a banner. Here that only costs a screenful and a
    refusal rather than a permanent record -- but the two tools disagreeing
    about what a pane holds would be worse than either bound.

    A banner that printed a Claude title rather than a uuid passes the
    harvest's two title gates too, over the hook's own records: a title this
    pane's block or sidecar records already name is not looked up, and one the
    hook refused is never looked up again. See resolve_title().
    """
    tag = RESURRECT.server_tag(server)
    marked, plain = RESURRECT.split_capture(capture(pane))
    rows = RESURRECT.cap_stanzas(RESURRECT.parse_stanzas(marked, pane, tag), pane, tag)
    seen = {row["session_id"] for row in rows}
    path = sidecar_path()
    seen_names = {(row.get("agent"), row.get("name")) for row in rows if row.get("name")}
    seen_names |= RESURRECT.recorded_names(RESURRECT.read_sidecar(path), server).get(pane, set())
    refused = RESURRECT.read_refused(path)

    index = []

    def resolve_title(name):
        """The uuid behind a title Claude printed instead of one, if it is certain.

        A third of this machine's sessions carry a custom title, and Claude's exit
        banner prints that rather than the uuid. `unique=True` because titles are
        free text: one that names more than one session resolves to nothing rather
        than to a coin flip. That answers only for today. Ambiguity expires: once
        Claude has pruned all but one of the sessions a title named, a fresh
        lookup confidently names the survivor, whichever pane printed the title.
        The save hook writes its refusals down for that reason, and a title it
        refused is refused here without being asked again. This tool writes
        nothing, so a refusal of its own lasts only for this run.
        """
        if name in refused:
            return None
        if not index:
            index.append(RESURRECT.name_index(unique=True))
        return index[0].get(name)

    recovered = []
    for agent, session_id, name in RESURRECT.extract(plain):
        if not session_id and agent == "claude" and name:
            # Compared in the form a record stores, as harvest() does:
            # normalise() truncates a name to 60 characters.
            stored = (agent, RESURRECT.clean(name, 60))
            if stored in seen_names:
                continue
            seen_names.add(stored)
            session_id = resolve_title(name)
        if not session_id or session_id in seen:
            continue
        seen.add(session_id)
        recovered.append(
            dict(
                agent=agent,
                session_id=session_id,
                name=name,
                cwd="",
                source=RESURRECT.SCROLLBACK_SOURCE,
                pid=None,
                started="",
                last_seen=None,
            )
        )
    return [dict(row, origin="scrollback") for row in rows + RESURRECT.cap_recovered(recovered, plain)]


def cache_row(pane, server):
    """The record this pane's session-start hook wrote, if this server issued its pane.

    The cache is keyed by pane number, which every tmux server counts from 0, so
    the record's own server stamp, and a date after this server started, are
    what tie it to this pane. One from an earlier server -- before a reboot --
    or from another server running beside this one names whatever pane held
    that number there. One with no stamp predates it and cannot be tied to
    anything, so it is skipped too.

    A record whose process is gone is the point of this source: that is a killed
    agent, which the session hook keeps for as long as its server runs precisely
    so it can be resumed here. One whose process is still there is kept too, and
    marked, since a `--pane` pointing elsewhere can reach a pane that really does
    have an agent in it.
    """
    if not server:
        return []
    path = os.path.join(REGISTER.REG, f'{pane.lstrip("%")}.json')
    try:
        with open(path) as fh:
            record = json.load(fh)
    except (OSError, ValueError):
        return []
    if not isinstance(record, dict) or record.get("pane_id") != pane or record.get("server") != server:
        return []
    if not record.get("session_id") or not isinstance(record["session_id"], str):
        return []
    # The id alone cannot tell two boots apart on Linux, where a server systemd
    # starts at boot can return with the same pid at the same tick; a record
    # dated before this server started is not from it.
    if not procinfo.tmux_server_running(server, RESURRECT.as_epoch(record.get("updated")) or 0):
        return []
    return [
        dict(
            agent=record.get("agent") or "",
            session_id=record["session_id"],
            name=record.get("name") or "",
            cwd=record.get("cwd") or "",
            source="hook",
            pid=record.get("pid"),
            started="",
            last_seen=RESURRECT.as_epoch(record.get("updated")),
            live=alive(record.get("pid"), record.get("proc_start")),
            origin="cache",
        )
    ]


def alive(pid, proc_start):
    """Whether that exact process is still running.

    The start time is in the test because a pid alone is reused, and a reused pid
    reported as the agent still running is the one error that would stop this
    offering the session a kill left behind.
    """
    if not pid or not proc_start:
        return False
    try:
        return str(procinfo.start_token(int(pid))) == str(proc_start)
    except (TypeError, ValueError):
        return False


# ---* Folding them into one answer *---


def merge(rows):
    """One row per (agent, session id), each field from its best attestation.

    The same session legitimately arrives from all three sources -- the sidecar
    knows its cwd, the block knows when it was last seen, the banner knows only
    that it was here -- so this is a merge rather than a first-wins.
    """
    out = {}
    for row in rows:
        agent, session_id = row.get("agent"), row.get("session_id")
        if not agent or not session_id:
            continue
        best = out.get((agent, session_id))
        if best is None:
            out[(agent, session_id)] = dict(row, origins={row.get("origin", "?")})
            continue
        if RESURRECT.source_rank(row.get("source")) < RESURRECT.source_rank(best.get("source")):
            best["source"] = row.get("source")
        for field in ("name", "cwd", "started", "pid"):
            if not best.get(field) and row.get(field):
                best[field] = row[field]
        if (RESURRECT.as_epoch(row.get("last_seen")) or 0) > (RESURRECT.as_epoch(best.get("last_seen")) or 0):
            best["last_seen"] = row.get("last_seen")
        best["live"] = bool(best.get("live") or row.get("live"))
        best["origins"].add(row.get("origin", "?"))
    return list(out.values())


def resolve(rows):
    """Mark each row resumable or not, and give it the cwd its resume needs.

    A session id with no transcript behind it cannot be resumed: both agents
    answer `--resume` out of those files, and Claude prunes its own at 30 days.
    Such a row is still shown -- it is true history, and being told the session
    has aged out is better than being told nothing -- but it is never chosen and
    never counted, so a pane holding one of those and one live id still answers
    "exactly one".

    The index is the save hook's own, so what this calls resumable and what the
    hook calls datable can never disagree.
    """
    index = RESURRECT.transcript_index()
    for row in rows:
        path = index.get(row["agent"], {}).get(row["session_id"], "")
        row["transcript"] = path
        row["gone"] = not path
        if not path:
            continue
        if not row.get("cwd"):
            # The one thing an exit banner never prints, and `claude --resume`
            # resolves its id inside the project dir of the current directory.
            row["cwd"] = RESURRECT.transcript_cwd(path)
        if not RESURRECT.as_epoch(row.get("last_seen")):
            # Only ever a fallback: a sidecar date is when an agent was *observed*
            # running here, which a transcript mtime is not. But a row read out of
            # a bare banner has no date at all, and undated it sorts below every
            # other candidate however recent it really is.
            try:
                row["last_seen"] = os.stat(path).st_mtime
            except OSError:
                pass
    return rows


def candidates(rows):
    """The rows that could be resumed at all.

    An agent this tool has no command for, or an id that is not a well-formed
    uuid, is not a candidate -- not a candidate that then loses. Both agents name
    sessions by uuid, so anything else came out of text that merely looked like a
    resume line.
    """
    return [
        row for row in rows
        if row["agent"] in RESUME_ARGV and UUID_RE.fullmatch(row["session_id"] or "")
    ]


def choose(rows):
    """(the row to resume, verdict). The rule, isolated so it can be asserted.

    One resumable candidate is a mapping; two is a guess, and a guess resumes
    somebody else's conversation while looking exactly like the right answer.
    Rows whose transcript is gone are not resumable and so cannot make a pane
    ambiguous -- nor can they be chosen by being the only one left.
    """
    options = [row for row in rows if not row["gone"]]
    if len(options) == 1:
        return options[0], "one"
    return None, "none" if not options else "many"


def order(rows):
    """Resumable first, then whatever ran here most recently."""
    return sorted(
        rows,
        key=lambda row: (
            not row["gone"],
            bool(row.get("live")),
            RESURRECT.as_epoch(row.get("last_seen")) or 0,
        ),
        reverse=True,
    )


# ---* Does the pane's history match the session? *---

# The pane's history and the resumed session's transcript are compared on the
# pane's last MATCH_PROBES lines long enough to say something; MATCH_HITS of them
# must appear in the transcript word for word. Most lines on an agent's screen
# never reach its transcript -- status bars, rendered markdown, shell prompts,
# reboot broadcasts -- so the bar is a few hits, not most of them. Measured on 11
# restored panes against 79 session transcripts (55 Claude, 24 Codex): the right
# session held 5 to 29 of the last 60 distinct lines, an unrelated one at most 2.
# A fork shares its parent's lines, so the two cannot be told apart this way; nor
# can a session that printed the pane, or one that ran the same shell commands.
MATCH_PROBES = 60
MATCH_HITS = 5
PROBE_MIN_ALNUM = 20
PROBE_CHARS = 60
# What the agents draw in front of a line: bullets, tool-output gutters, prompts.
DECORATION = " \t┃●•◦⎿✻※›❯>$"


def probes(plain):
    """The pane's recent lines its session's transcript should hold, oldest first.

    Only the first PROBE_CHARS of each, since the agents render markdown and
    re-wrap paragraphs, and the further a line runs the likelier it crosses a
    `code` span or a bold the screen dropped.
    """
    out = []
    for line in plain.splitlines():
        # A rendered table's cells, each of which the transcript holds as text
        # between markdown pipes; the row as drawn appears nowhere.
        for cell in line.split("│"):
            text = cell.strip().lstrip(DECORATION).rstrip()
            if sum(char.isalnum() for char in text) >= PROBE_MIN_ALNUM:
                out.append(text[:PROBE_CHARS])
    # A line the pane repeats -- a shell prompt, above all -- is one piece of
    # evidence, not one per repeat. The most recent occurrence keeps its place.
    return list(dict.fromkeys(reversed(out)))[:MATCH_PROBES][::-1]


def hits(lines, transcript):
    """How many of those lines the transcript holds, in the form JSON stores them."""
    return sum(json.dumps(line, ensure_ascii=False)[1:-1] in transcript for line in lines)


# ---* Resuming beside the pane *---

START_TIMEOUT_S = 20
# A resume that cannot find its session exits within a second or two of starting.
SETTLE_S = 3


def tmux(*args):
    """A tmux command's output, or None where it failed."""
    try:
        out = subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=TMUX_TIMEOUT_S)
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout.strip() if out.returncode == 0 else None


def pane_agent(pane):
    """The agent running in `pane` right now, anywhere below its shell, or "".

    By process rather than by #{pane_current_command}: an installed Claude on
    macOS runs as its version number, and a shell's own startup puts other
    commands in the foreground first.
    """
    root = tmux("display", "-p", "-t", pane, "#{pane_pid}")
    if not root or not root.isdigit():
        return ""
    kids, comms = procinfo.process_table()
    stack = [int(root)]
    while stack:
        pid = stack.pop()
        kind = agents.agent_kind(pid, comms.get(pid, ""))
        if kind:
            return kind
        stack.extend(kids.get(pid, []))
    return ""


def started(pane, agent):
    """Whether `agent` came up in `pane`, and was still up SETTLE_S later."""
    deadline = time.monotonic() + START_TIMEOUT_S
    while time.monotonic() < deadline:
        if pane_agent(pane) == agent:
            time.sleep(SETTLE_S)
            return pane_agent(pane) == agent
        time.sleep(0.5)
    return False


def resume_beside(pane, row, line, keep=""):
    """Resume `row` in a new pane split off `pane`; close `pane` if its history matches.

    The way it is done by hand, so that a wrong mapping costs nothing: split,
    start the resume command in the new pane, and keep the old pane until it is
    clear the right session came up. Here "clear" is the old pane's history
    matching the session's transcript (see probes()). Anything short of that --
    the agent not starting, too few lines in common, nothing to compare, a
    reason in `keep`, an agent in `pane` -- keeps both panes and says why.

    The history is read before the split, so it is what the reader was looking
    at. The transcript is read after the agent is up, under whatever name it has
    then: resuming a Codex session rewrites a compressed rollout as plain jsonl.
    On a match `pane` is killed, and this process with it, since it runs there.
    """
    lines = probes(RESURRECT.split_capture(capture(pane))[1])
    # Run as the new pane's command rather than typed into it: a shell still
    # starting up can keep typed text and drop its Enter. Interactive, so it reads
    # the rc files a typed command would see, and a login shell is left behind
    # when the agent exits, as in any other pane.
    shell = os.environ.get("SHELL") or "/bin/sh"
    command = [shell, "-ic", f"{line}; exec {RESURRECT.shell_quote(shell)} -l"]
    cwd = row.get("cwd") or "#{pane_current_path}"
    new = tmux("split-window", "-h", "-t", pane, "-c", cwd, "-P", "-F", "#{pane_id}", *command)
    if not new:
        fail(f"could not split {pane}")
        return 3

    up = started(new, row["agent"])
    path = agents.transcript_index().get(row["agent"], {}).get(row["session_id"]) or row["transcript"]
    found = hits(lines, agents.transcript_text(path)) if up else 0
    if not up:
        why = f"{row['agent']} was not running in {new} after {START_TIMEOUT_S}s"
    elif not lines:
        why = f"{pane}'s history has nothing to compare it with"
    elif found < MATCH_HITS:
        why = f"{found} of {pane}'s last {len(lines)} lines are in its transcript, {MATCH_HITS} needed"
    elif keep:
        why = f"{pane}'s history matches, but {keep}"
    elif pane_agent(pane):
        # Asked again here and not only before the split, because --force gets
        # past that check: whatever it overrides, a pane with an agent in it is
        # never closed.
        why = f"{pane}'s history matches, but an agent is running in it"
    else:
        tmux("kill-pane", "-t", pane)
        return 0
    print(f"agent-resume: started {row['agent']} {row['session_id']} in {new}, and kept {pane}:")
    print(f"  {why}.")
    print(f"  The resume command is in {new}: close one of the two panes rather than")
    print(f"  running agent-resume in {pane} again, which would start a second copy.")
    return 4


# ---* Output *---


def stamp(row):
    seen = RESURRECT.as_epoch(row.get("last_seen"))
    if not seen:
        return "-"
    return time.strftime("%m-%d %H:%M", time.localtime(seen))


def note(row):
    if row["gone"]:
        return "  (transcript gone)"
    return "  (still running)" if row.get("live") else ""


def show(rows, pane, where, stream=sys.stdout):
    """The candidate table.

    Written to stderr on every path but `--list`, so that `agent-resume -n`
    stays a single pipeable line and a refusal's evidence does not end up in
    whatever the caller was capturing.
    """
    out = [f"{pane} has held {len(rows)} agent session(s) — {where}", ""]
    header = f'{"#":<4}{"AGENT":<8}{"SESSION ID":<38}{"LAST SEEN":<13}{"SRC":<12}NAME'
    out += [header, "-" * len(header)]
    for number, row in enumerate(rows, 1):
        out.append(
            f'{number:<4}{row["agent"]:<8}{row["session_id"]:<38}{stamp(row):<13}'
            f'{str(row.get("source") or "?"):<12}{str(row.get("name") or "")[:32]}{note(row)}'.rstrip()
        )
    print("\n".join(out) + "\n", file=stream)


def command_line(row):
    """The `cd X && agent ...` the reader can copy, as one shell-safe string."""
    quote = RESURRECT.shell_quote
    words = " ".join(quote(word) for word in argv_for(row))
    return f"cd {quote(row['cwd'])} && {words}" if row.get("cwd") else words


def argv_for(row):
    return [word.format(sid=row["session_id"]) for word in RESUME_ARGV[row["agent"]]]


# ---* Entry point *---


def parse_args(argv):
    """(options, error). Hand-parsed: five flags, and argparse's own -h output
    would replace a docstring that is the tool's only documentation.

    There is no flag naming a session, by number or by id. Anything that selects
    one is a way to start a session this tool could not map by itself, which is
    the single thing it is not allowed to do -- `--list` prints the commands, and
    pasting one puts the decision back where it belongs.
    """
    opts = dict(pane="", dry_run=False, listing=False, here=False, force=False)
    rest = list(argv)
    while rest:
        arg = rest.pop(0)
        if arg in ("-n", "--dry-run"):
            opts["dry_run"] = True
        elif arg == "--here":
            opts["here"] = True
        elif arg in ("-l", "--list"):
            opts["listing"] = True
        elif arg == "--force":
            opts["force"] = True
        elif arg == "--pane":
            if not rest:
                return opts, "--pane needs a pane id"
            opts["pane"] = rest.pop(0)
        elif arg.startswith("--pane="):
            opts["pane"] = arg.split("=", 1)[1]
        else:
            return opts, f"unknown argument: {arg}"
    if opts["pane"] and not opts["pane"].startswith("%"):
        opts["pane"] = "%" + opts["pane"].lstrip("%")
    return opts, ""


def fail(message):
    print(f"agent-resume: {message}", file=sys.stderr)


# Cursor home, then erase the display. Deliberately *not* the `ESC[3J` that
# `clear` also sends on most terminfo entries: tmux answers that one by dropping
# the pane's scrollback, and that scrollback is a source this family reads. For a
# session that started and exited between two saves the banner sitting there is
# the only record of it that exists, and nothing has folded it into the sidecar
# yet. Clearing the screen costs nothing; clearing the history could cost an id.
CLEAR = "\x1b[H\x1b[2J"


def clear_pane():
    """Wipe the visible screen, so the session starts on a clean pane.

    A restored pane opens showing whatever it was replaying -- the old contents,
    the injected block, the previous agent's parting banner -- and resuming under
    all of it starts the new session halfway down a screen of stale text.
    """
    if sys.stdout.isatty():
        sys.stdout.write(CLEAR)
        sys.stdout.flush()


def run(argv):
    opts, error = parse_args(argv)
    if error:
        fail(error)
        fail("usage: agent-resume [-n|--dry-run] [-l|--list] [--here] [--pane %N] [--force]")
        return 3

    # Without $TMUX every tmux call resolves against the *default* server, so the
    # capture, the pane list and @resurrect-dir would all answer for a session
    # this one has nothing to do with.
    if not os.environ.get("TMUX"):
        fail("not inside tmux; there is no pane to map")
        return 3
    if RESURRECT.IMPORT_ERROR:
        # Without the shared patterns extract() matches nothing and the whole
        # scrollback source silently disappears, which here would read as "this
        # pane never held a session".
        fail(f"shared resume-marker patterns unavailable: {RESURRECT.IMPORT_ERROR}")
        return 3

    pane = opts["pane"] or os.environ.get("TMUX_PANE") or ""
    if not pane:
        fail("TMUX_PANE is unset; pass --pane %N")
        return 3

    server = RESURRECT.server_id()
    rows = order(
        resolve(
            candidates(
                merge(
                    sidecar_rows(pane, server)
                    + capture_rows(pane, server)
                    + cache_row(pane, server)
                )
            )
        )
    )

    where = "sidecar, scrollback and hook cache"
    if opts["listing"]:
        if not rows:
            print(f"{pane} has held no agent session this tool can see — {where}")
            return 1
        show(rows, pane, where)
        for number, row in enumerate(rows, 1):
            print(f"{number}. {command_line(row)}")
        return 0

    # Start a session only where the pane maps to one, confidently and by itself.
    chosen, verdict = choose(rows)
    if verdict != "one":
        if rows:
            show(rows, pane, where, sys.stderr)
        if verdict == "none":
            fail(f"no resumable agent session maps to {pane}")
            print("  agent-scrollback-ids sweeps every pane, and offers a best guess", file=sys.stderr)
            print("  where this refuses to.", file=sys.stderr)
            return 1
        fail(f"{pane} maps to more than one resumable session; refusing to guess")
        print("  agent-resume --list prints the command for each; paste the one you meant.", file=sys.stderr)
        return 2

    line = command_line(chosen)
    if opts["dry_run"]:
        print(line)
        return 0

    keep = ""
    if chosen.get("cwd") and not os.path.isdir(chosen["cwd"]):
        fail(f"recorded directory is gone, resuming from the pane's: {chosen['cwd']}")
        chosen["cwd"] = ""
        line = command_line(chosen)
        # `claude --resume` looks its id up under the current directory, so
        # from anywhere else it is expected to fail -- possibly after a prompt
        # that outlasts SETTLE_S.
        keep = "the session's directory is gone, so it was started from the pane's"

    # Running inside an agent's own shell tool is the one context where the pane
    # mapping is right and resuming is still wrong: in place it would start a
    # second agent inside the first one's tool call, on a terminal that is not
    # one; beside the pane, nobody is there to compare the two.
    agent_pid, _ = REGISTER.agent_process()
    if agent_pid and not opts["force"]:
        fail(f"an agent is already running above this shell (pid {agent_pid})")
        print("  --dry-run prints the command instead; --force runs it anyway.", file=sys.stderr)
        return 3

    if not opts["here"]:
        # A pane with an agent in it is not one whose session needs resuming;
        # resume_beside() asks again before closing anything, since --force gets
        # past this.
        running = pane_agent(pane)
        if running and not opts["force"]:
            fail(f"{running} is already running in {pane}")
            print("  --dry-run prints the command instead; --force runs it anyway.", file=sys.stderr)
            return 3
        if pane != os.environ.get("TMUX_PANE"):
            # Run in its own pane, the pane's foreground job is this tool; aimed
            # elsewhere with --pane, it could be anything.
            keep = keep or "agent-resume closes only the pane it runs in"
        return resume_beside(pane, chosen, line, keep)

    argv_out = argv_for(chosen)
    clear_pane()
    # After the clear, so the one line the pane keeps says what is about to run.
    print(f"agent-resume: {line}", file=sys.stderr)
    if chosen.get("cwd"):
        os.chdir(chosen["cwd"])
    try:
        os.execvp(argv_out[0], argv_out)
    except OSError as err:
        fail(f"cannot run {argv_out[0]}: {err}")
        return 3


def main():
    if "-h" in sys.argv[1:] or "--help" in sys.argv[1:]:
        print(__doc__.strip())
        return 0
    return run(sys.argv[1:])


if __name__ == "__main__":
    sys.exit(main())
