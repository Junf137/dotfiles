# ignore all log file
*.log
logs/

# ignore temporary file created by vim
*.swp

# python bytecode — the agent-sessions tools are imported by their test suite,
# which materializes these next to executables that sit on PATH
__pycache__/
*.pyc

# ignore all files in .vscode
.vscode/
.cursor/
.claude/settings.local.json
CLAUDE.local.md

# yazi packages — managed by `ya pkg`, materialized by bootstrap.sh from yazi/package.toml
yazi/flavors/
yazi/plugins/
